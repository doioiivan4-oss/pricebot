'use client'
import { useState } from 'react'
export default function Page(){
  const [url, setUrl] = useState('')
  const [data, setData] = useState<any>(null)
  const [loading, setLoading] = useState(false)
  async function check(){
    if(!url) return
    setLoading(true)
    try{
      const res = await fetch(/api/check?url=${encodeURIComponent(url)})
      const json = await res.json()
      setData(json)
    }catch(e:any){ setData({error:e.message}) }
    setLoading(false)
  }
  return (
    <div style={{maxWidth:700, margin:'50px auto', padding:20}}>
      <h1 style={{fontSize:32}}>💰 PriceBot - مراقب الأسعار</h1>
      <p style={{opacity:0.7}}>حط رابط المنتج وشوف السعر</p>
      <div style={{display:'flex', gap:10, marginTop:20}}>
        <input value={url} onChange={e=>setUrl(e.target.value)} placeholder="https://..." style={{flex:1, padding:12, borderRadius:8, border:'1px solid #333', background:'#111', color:'#fff'}} />
        <button onClick={check} disabled={loading} style={{padding:'12px 20px', borderRadius:8, background:'#fff', color:'#000', fontWeight:700, cursor:'pointer'}}>{loading?'...':'فحص'}</button>
      </div>
      {data && <pre style={{marginTop:20, background:'#111', padding:20, borderRadius:10, overflow:'auto'}}>{JSON.stringify(data, null, 2)}</pre>}
    </div>
  )
}
